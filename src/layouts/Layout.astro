---
import "../styles/global.css";
import { getCollection } from "astro:content";

export interface Props {
    title: string;
}

const { title } = Astro.props;

const posts = await getCollection("posts");
const sources = [...new Set(posts.map((post) => post.data.source))].sort();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body
        class="flex flex-col md:flex-row min-h-screen bg-base text-ct-text font-sans antialiased"
    >
        <aside
            class="w-full md:w-72 bg-mantle md:border-r border-b md:border-b-0 border-surface0 p-6 flex flex-col gap-6 md:gap-8 md:h-screen md:sticky top-0 overflow-y-auto z-10 shadow-sm md:shadow-none"
        >
            <div class="flex justify-between items-center md:block">
                <div>
                    <h1 class="text-3xl font-bold text-mauve tracking-tight">
                        SumAI
                    </h1>
                    <p class="text-sm text-subtext0 mt-1 md:mt-2">
                        Tech blog TLDR aggregator.
                    </p>
                </div>
            </div>

            <nav
                class="flex flex-row md:flex-col gap-6 md:gap-8 overflow-x-auto md:overflow-visible pb-2 md:pb-0 hide-scrollbar"
            >
                <div class="shrink-0">
                    <h2
                        class="text-xs font-semibold text-overlay1 uppercase tracking-wider mb-3 hidden md:block"
                    >
                        Navigation
                    </h2>
                    <ul class="flex flex-row md:flex-col gap-1 md:gap-1">
                        <li>
                            <a
                                href="/"
                                class="block px-3 py-2 rounded-md text-subtext1 hover:text-ct-text hover:bg-surface0 transition-colors whitespace-nowrap"
                            >
                                Home
                            </a>
                        </li>
                        <li>
                            <a
                                href="/tags"
                                class="block px-3 py-2 rounded-md text-subtext1 hover:text-ct-text hover:bg-surface0 transition-colors whitespace-nowrap"
                            >
                                All Tags
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="shrink-0">
                    <h2
                        class="text-xs font-semibold text-overlay1 uppercase tracking-wider mb-3 hidden md:block"
                    >
                        Sources
                    </h2>
                    <ul class="flex flex-row md:flex-col gap-1 md:gap-1">
                        {
                            sources.map((source) => (
                                <li>
                                    <a
                                        href={`/sources/${source}`}
                                        class="block px-3 py-2 rounded-md text-subtext1 hover:text-ct-text hover:bg-surface0 transition-colors whitespace-nowrap"
                                    >
                                        {source.charAt(0).toUpperCase() +
                                            source.slice(1)}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </nav>
        </aside>

        <main
            class="flex-grow p-6 sm:p-8 md:p-12 lg:p-16 w-full max-w-4xl mx-auto"
        >
            <slot />
        </main>
    </body>
</html>
