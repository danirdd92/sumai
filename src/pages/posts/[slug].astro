---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title}>
    <article class="max-w-3xl mx-auto">
        <header class="mb-10 border-b border-surface0 pb-8">
            <h1
                class="text-4xl md:text-5xl font-extrabold text-ct-text tracking-tight mb-6 leading-tight"
            >
                {post.data.title}
            </h1>

            <div class="flex flex-wrap items-center gap-4 text-subtext0 mb-6">
                <span
                    class="flex items-center gap-1.5 font-medium text-sapphire bg-sapphire/10 px-3 py-1 rounded-full text-sm"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><circle cx="12" cy="12" r="10"></circle><path
                            d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"
                        ></path><path d="M2 12h20"></path></svg
                    >
                    <a
                        href={`${import.meta.env.BASE_URL}sources/${post.data.source}`}
                        class="hover:text-sapphire hover:underline"
                        >{post.data.source}</a
                    >
                </span>
                <time
                    datetime={post.data.publishDate.toISOString()}
                    class="text-overlay0 flex items-center gap-1.5"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><rect width="18" height="18" x="3" y="4" rx="2" ry="2"
                        ></rect><line x1="16" x2="16" y1="2" y2="6"></line><line
                            x1="8"
                            x2="8"
                            y1="2"
                            y2="6"></line><line x1="3" x2="21" y1="10" y2="10"
                        ></line></svg
                    >
                    {
                        post.data.publishDate.toLocaleDateString(undefined, {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </time>
            </div>

            <div class="flex flex-wrap gap-2 mb-8">
                {
                    post.data.tags.map((tag) => (
                        <object>
                            <a
                                href={`${import.meta.env.BASE_URL}tags/${tag}`}
                                class="inline-flex items-center px-3 py-1.5 rounded-full bg-surface0/50 text-subtext1 text-sm font-medium hover:bg-surface1 hover:text-ct-text transition-colors border border-surface0"
                            >
                                <span class="text-overlay1 mr-1">#</span>
                                {tag}
                            </a>
                        </object>
                    ))
                }
            </div>

            <a
                href={post.data.originalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-blue text-base font-semibold hover:bg-blue/90 transition-colors shadow-sm text-crust"
            >
                Read Original Article
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M7 7h10v10"></path><path d="M7 17 17 7"
                    ></path></svg
                >
            </a>
        </header>

        <div
            class="prose prose-invert prose-catppuccin max-w-none text-subtext0"
        >
            <Content />
        </div>
    </article>
</Layout>

<style is:global>
    .prose-catppuccin h1,
    .prose-catppuccin h2,
    .prose-catppuccin h3,
    .prose-catppuccin h4 {
        color: var(--color-ct-text);
        font-weight: 700;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        line-height: 1.3;
    }
    .prose-catppuccin h1 {
        font-size: 2.25rem;
    }
    .prose-catppuccin h2 {
        font-size: 1.875rem;
        border-bottom: 1px solid var(--color-surface0);
        padding-bottom: 0.5rem;
    }
    .prose-catppuccin h3 {
        font-size: 1.5rem;
    }

    .prose-catppuccin p {
        margin-bottom: 1.5rem;
        line-height: 1.75;
    }

    .prose-catppuccin a {
        color: var(--color-blue);
        text-decoration: underline;
        text-decoration-color: var(--color-blue);
        text-underline-offset: 4px;
        transition:
            color 0.2s,
            text-decoration-color 0.2s;
    }
    .prose-catppuccin a:hover {
        color: var(--color-sapphire);
        text-decoration-color: var(--color-sapphire);
    }

    .prose-catppuccin ul,
    .prose-catppuccin ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    .prose-catppuccin ul {
        list-style-type: disc;
    }
    .prose-catppuccin ol {
        list-style-type: decimal;
    }
    .prose-catppuccin li {
        margin-bottom: 0.5rem;
    }

    .prose-catppuccin blockquote {
        border-left: 4px solid var(--color-overlay0);
        padding-left: 1rem;
        font-style: italic;
        color: var(--color-subtext1);
        background: var(--color-surface0);
        padding: 1rem 1.5rem;
        border-radius: 0 0.5rem 0.5rem 0;
        margin-bottom: 1.5rem;
    }

    .prose-catppuccin pre {
        background-color: var(--color-mantle);
        padding: 1.25rem;
        border-radius: 0.75rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        border: 1px solid var(--color-surface0);
    }

    .prose-catppuccin code {
        background-color: var(--color-surface0);
        color: var(--color-pink);
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
        font-family: monospace;
    }

    .prose-catppuccin pre code {
        background-color: transparent;
        color: inherit;
        padding: 0;
        font-size: 0.9em;
    }

    .prose-catppuccin img {
        max-width: 100%;
        height: auto;
        border-radius: 0.75rem;
        margin: 2rem 0;
        border: 1px solid var(--color-surface0);
    }

    .prose-catppuccin hr {
        border: 0;
        border-top: 1px solid var(--color-surface0);
        margin: 3rem 0;
    }
</style>
