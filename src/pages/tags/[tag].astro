---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

    return tags.map((tag) => {
        const filteredPosts = posts.filter((post) =>
            post.data.tags.includes(tag),
        );
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

posts.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout title={`Topic: ${tag} - SumAI`}>
    <div class="mb-12 flex items-center gap-4">
        <h1 class="text-4xl font-extrabold text-ct-text tracking-tight">
            <span class="text-overlay0 mr-1 font-normal">#</span>{tag}
        </h1>
        <span
            class="text-subtext0 bg-surface0 px-3 py-1 rounded-full text-sm font-medium"
            >{posts.length} articles</span
        >
    </div>

    <ul class="flex flex-col gap-6">
        {
            posts.map((post) => (
                <li>
                    <a
                        href={`/posts/${post.id}`}
                        class="block group p-6 rounded-2xl bg-surface0/30 hover:bg-surface0 border border-transparent hover:border-surface1 transition-all duration-300"
                    >
                        <div class="flex items-center gap-3 mb-3 text-sm text-subtext1">
                            <span class="flex items-center gap-1.5 text-sapphire font-medium">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <>
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                                        <path d="M2 12h20" />
                                    </>
                                </svg>
                                {post.data.source}
                            </span>
                            <span class="text-surface2">&bull;</span>
                            <time
                                datetime={post.data.publishDate.toISOString()}
                                class="text-overlay1"
                            >
                                {post.data.publishDate.toLocaleDateString(
                                    undefined,
                                    {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric",
                                    },
                                )}
                            </time>
                        </div>

                        <h2 class="text-2xl font-bold text-ct-text group-hover:text-blue transition-colors">
                            {post.data.title}
                        </h2>
                    </a>
                </li>
            ))
        }
    </ul>
</Layout>
